{
  "plugins": [
    {
      "manifest": {
        "plugin_id": "community.mdblist-sync",
        "version": "1.0.6",
        "checksum": "15173949b5d2af935b603b2f91b3d270650ee083e3c1b620382c0c4697a0a6a8",
        "silo_api_version": "v1",
        "presentation": {
          "display_name": "MDBList Sync",
          "summary": "Sync private and public MDBList collections (Dynamic, AI, Static, Feed) into Silo libraries.",
          "description_markdown": "Synchronizes your private, unlisted, and public MDBList lists (Dynamic, AI, Static, Feed, Liked, and External) into Silo Server. MDBList Sync always creates new collections with their own dedicated IDs, so it never touches or modifies your existing collections.\n\n- **Full privacy & multi-library matching:** Reads private lists via your personal API key and lets you map each list to specific Movie and TV libraries.\n- **Order, visibility & cleanup:** Optionally preserve original MDBList rank order, hide empty collections until titles are available, and cleanly remove disabled collections.\n- **Flexible & event-driven sync:** Runs every 24 hours by default, supports more frequent custom schedules directly inside the plugin, and reacts automatically when library items change.\n- **Full localization:** Translated into all 37 languages supported by Silo Server, automatically following your active interface language.\n- **Built-in diagnostics:** View live sync logs and copy anonymized logs with credentials stripped for safe troubleshooting.\n\n*Disclaimer: This is an independent community plugin. You can inspect the full source code on GitHub. Always keep a backup of your Silo data \u2014 use at your own risk.*",
          "setup_markdown": "1. Enter your **MDBList API Key** (from `mdblist.com/preferences/#api`) and **Silo Admin API Key** (from **Administration \u2192 API Keys**) below.\n2. Open **MDBList Sync** in the admin sidebar to fetch your lists and enable the ones you want to sync.\n3. Sync runs automatically every **24 hours** by default \u2014 you can choose a more frequent schedule directly inside the plugin under **Tasks**.",
          "homepage_url": "https://github.com/spaceabovethetrees/silo-plugin-mdblist-sync",
          "source_url": "https://github.com/spaceabovethetrees/silo-plugin-mdblist-sync",
          "support_url": "https://github.com/spaceabovethetrees/silo-plugin-mdblist-sync/issues",
          "changelog_url": "https://github.com/spaceabovethetrees/silo-plugin-mdblist-sync/releases",
          "publisher_name": "spaceabovethetrees",
          "publisher_url": "https://github.com/spaceabovethetrees",
          "license_spdx": "MIT"
        },
        "capabilities": [
          {
            "type": "scheduled_task.v1",
            "id": "sync",
            "display_name": "Sync MDBList Collections",
            "description": "Synchronizes enabled private and public MDBList lists with Silo collections.",
            "scheduled_task": {
              "default_trigger": {
                "type": "daily",
                "time_of_day": "03:00"
              }
            }
          },
          {
            "type": "http_routes.v1",
            "id": "web-ui",
            "display_name": "MDBList Sync Page",
            "description": "Administrator page for managing private and public MDBList collection sync."
          },
          {
            "type": "event_consumer.v1",
            "id": "events",
            "subscriptions": [
              "catalog.library.changed"
            ]
          }
        ],
        "global_config_schema": [
          {
            "key": "settings",
            "title": "MDBList & Silo API Credentials",
            "description": "Credentials used to read your private MDBList lists and manage collections in Silo.",
            "json_schema": "{\"type\":\"object\",\"required\":[\"mdblist_api_key\",\"silo_api_key\"],\"properties\":{\"mdblist_api_key\":{\"type\":\"string\",\"minLength\":1},\"silo_api_key\":{\"type\":\"string\",\"minLength\":1}},\"additionalProperties\":false}",
            "required": true,
            "admin_form": {
              "fields": [
                {
                  "key": "mdblist_api_key",
                  "label": "MDBList API Key",
                  "description": "Personal API key from mdblist.com/preferences/#api.",
                  "control": 3,
                  "required": true,
                  "secret": true
                },
                {
                  "key": "silo_api_key",
                  "label": "Silo Admin API Key",
                  "description": "Administrator API key created in Administration \u2192 API Keys.",
                  "control": 3,
                  "required": true,
                  "secret": true
                }
              ],
              "submit_label": "Save credentials"
            }
          }
        ],
        "http_routes": [
          {
